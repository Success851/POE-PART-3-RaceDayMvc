
@model List<RaceDayMvc.Models.Event>
@using RaceDayMvc.Models

@{
    var categoriesByEvent =
        ViewBag.CategoriesByEvent as Dictionary<int, List<Category>>;
}

<h2 class="mb-4">Upcoming Events</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <p>No events are currently available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToShortDateString()</td>
                        <td>@item.Location</td>
                        <td>@item.DistanceKm km</td>
                        <td>@item.EventType</td>

                        <td>
                            @if (categoriesByEvent != null &&
                                 categoriesByEvent.ContainsKey(item.EventID) &&
                                 categoriesByEvent[item.EventID].Count > 0)
                            {
                                <form asp-controller="Events"
                                      asp-action="Enrol"
                                      method="post">

                                    <input type="hidden"
                                           name="eventId"
                                           value="@item.EventID" />

                                    <select name="categoryId"
                                            class="form-select"
                                            required>
                                        @foreach (var category in categoriesByEvent[item.EventID])
                                        {
                                            <option value="@category.CategoryID">
                                                @category.CategoryName
                                                (@category.DistanceKm km)
                                            </option>
                                        }
                                    </select>

                                    <button type="submit"
                                            class="btn btn-success mt-2">
                                        Enrol
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span>No categories available</span>
                            }
                        </td>

                        <td>
                            @if (categoriesByEvent != null &&
                                 categoriesByEvent.ContainsKey(item.EventID) &&
                                 categoriesByEvent[item.EventID].Count > 0)
                            {
                                <span>Select a category to enrol</span>
                            }
                            else
                            {
                                <span>Not available</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
